<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đơn hàng của tôi - VanChuyenDo</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="style.css">
    <link rel="stylesheet" href="customer-style.css">
    <style>
        .filter-panel {
            background: white;
            border-radius: 12px;
            padding: 25px;
            margin-bottom: 25px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
        }
        
        .filter-section {
            margin-bottom: 20px;
        }
        
        .filter-section:last-child {
            margin-bottom: 0;
        }
        
        .filter-label {
            font-weight: 600;
            margin-bottom: 12px;
            color: #2c3e50;
            display: block;
        }
        
        .filter-buttons {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-bottom: 20px;
        }
        
        .search-sort-row {
            display: grid;
            grid-template-columns: 1fr 250px auto;
            gap: 15px;
            align-items: end;
        }
        
        .form-group {
            margin-bottom: 0;
        }
        
        .orders-container {
            background: white;
            border-radius: 12px;
            padding: 25px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
        }
        
        .orders-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            padding-bottom: 15px;
            border-bottom: 2px solid #ecf0f1;
        }
        
        .orders-count {
            font-size: 1.1rem;
            color: #7f8c8d;
        }
        
        .orders-count strong {
            color: #2c3e50;
            font-size: 1.3rem;
        }
        
        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: #7f8c8d;
        }
        
        .empty-state i {
            font-size: 4rem;
            margin-bottom: 20px;
            opacity: 0.3;
        }
        
        .empty-state h3 {
            margin-bottom: 10px;
            color: #2c3e50;
        }
        
        /* Rating Modal */
        .rating-modal {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.7);
            z-index: 10000;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        
        .rating-content {
            background: white;
            border-radius: 15px;
            padding: 35px;
            max-width: 500px;
            width: 100%;
            box-shadow: 0 15px 50px rgba(0, 0, 0, 0.3);
        }
        
        .rating-content h3 {
            margin: 0 0 25px 0;
            text-align: center;
            color: #2c3e50;
        }
        
        .star-rating {
            display: flex;
            justify-content: center;
            gap: 10px;
            font-size: 2.5rem;
            margin-bottom: 25px;
        }
        
        .star-rating i {
            cursor: pointer;
            color: #ddd;
            transition: all 0.2s;
        }
        
        .star-rating i:hover,
        .star-rating i.active {
            color: #f39c12;
            transform: scale(1.1);
        }
        
        .rating-comment {
            margin-bottom: 25px;
        }
        
        .rating-comment textarea {
            width: 100%;
            min-height: 100px;
            padding: 12px;
            border: 1px solid #ddd;
            border-radius: 8px;
            resize: vertical;
            font-family: inherit;
        }
        
        .rating-actions {
            display: flex;
            gap: 10px;
            justify-content: flex-end;
        }
        
        @media (max-width: 992px) {
            .search-sort-row {
                grid-template-columns: 1fr;
            }
        }
        
        @media (max-width: 768px) {
            .filter-buttons {
                justify-content: center;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Sidebar -->
        <div class="sidebar">
            <div class="sidebar-header">
                <h2><i class="fas fa-shopping-bag"></i> Khách hàng</h2>
            </div>
            <div class="sidebar-menu">
                <ul>
                    <li><a href="index-customer.html"><i class="fas fa-home"></i> Trang chủ</a></li>
                    <li><a href="customer-create-order.html"><i class="fas fa-plus-circle"></i> Tạo đơn hàng</a></li>
                    <li class="active"><a href="customer-my-orders.html"><i class="fas fa-box"></i> Đơn hàng của tôi</a></li>
                    <li><a href="index-customer.html"><i class="fas fa-search"></i> Tra cứu đơn hàng</a></li>
                    <li><a href="customer-payment-history.html"><i class="fas fa-receipt"></i> Lịch sử thanh toán</a></li>
                    <li><a href="customer-account.html"><i class="fas fa-user-circle"></i> Tài khoản</a></li>
                    <li><a href="customer-support.html"><i class="fas fa-headset"></i> Hỗ trợ</a></li>
                </ul>
            </div>
        </div>
        
        <!-- Main Content -->
        <div class="main-content">
            <!-- Header -->
            <div class="header">
                <div class="header-left">
                    <h1><i class="fas fa-box"></i> Đơn hàng của tôi</h1>
                    <p style="margin: 5px 0 0 0; color: #7f8c8d;">Quản lý và theo dõi tất cả đơn hàng của bạn</p>
                </div>
                <div class="header-right">
                    <button class="btn btn-success" onclick="window.location.href='customer-create-order.html'">
                        <i class="fas fa-plus"></i> Tạo đơn mới
                    </button>
                    <div class="user-info">
                        <div class="user-avatar">KH</div>
                        <div>
                            <div class="user-name" id="user-name">Khách hàng</div>
                            <div class="user-role">Tài khoản cá nhân</div>
                        </div>
                    </div>
                    <button class="btn btn-primary" onclick="logout()"><i class="fas fa-sign-out-alt"></i> Đăng xuất</button>
                </div>
            </div>

            <!-- Content -->
            <div class="content">
                <!-- Filter Panel -->
                <div class="filter-panel">
            <div class="filter-section">
                <span class="filter-label">
                    <i class="fas fa-filter"></i> Lọc theo trạng thái
                </span>
                <div class="filter-buttons">
                    <button class="filter-btn active" data-status="all" onclick="filterByStatus('all')" style="border-color: #7f8c8d; color: #7f8c8d;">
                        <i class="fas fa-list"></i> Tất cả
                    </button>
                    <button class="filter-btn" data-status="pending" onclick="filterByStatus('pending')" style="border-color: #3498db; color: #3498db;">
                        <i class="fas fa-clock"></i> Chờ xử lý
                    </button>
                    <button class="filter-btn" data-status="assigned" onclick="filterByStatus('assigned')" style="border-color: #9b59b6; color: #9b59b6;">
                        <i class="fas fa-user-check"></i> Đã phân công
                    </button>
                    <button class="filter-btn" data-status="picking" onclick="filterByStatus('picking')" style="border-color: #f39c12; color: #f39c12;">
                        <i class="fas fa-hand-holding-box"></i> Đang lấy hàng
                    </button>
                    <button class="filter-btn" data-status="delivering" onclick="filterByStatus('delivering')" style="border-color: #e67e22; color: #e67e22;">
                        <i class="fas fa-shipping-fast"></i> Đang giao
                    </button>
                    <button class="filter-btn" data-status="delivered" onclick="filterByStatus('delivered')" style="border-color: #27ae60; color: #27ae60;">
                        <i class="fas fa-check-circle"></i> Đã giao
                    </button>
                    <button class="filter-btn" data-status="cancelled" onclick="filterByStatus('cancelled')" style="border-color: #e74c3c; color: #e74c3c;">
                        <i class="fas fa-ban"></i> Đã hủy
                    </button>
                </div>
            </div>
            
            <div class="filter-section">
                <div class="search-sort-row">
                    <div class="form-group">
                        <label class="filter-label">
                            <i class="fas fa-search"></i> Tìm kiếm
                        </label>
                        <input type="text" class="form-control" id="order-search" 
                               placeholder="🔍 Tìm theo mã đơn, tên, số điện thoại, địa chỉ..." 
                               onkeyup="searchOrders()">
                    </div>
                    <div class="form-group">
                        <label class="filter-label">
                            <i class="fas fa-sort"></i> Sắp xếp
                        </label>
                        <select class="form-control" id="order-sort" onchange="sortOrders(this.value)">
                            <option value="date-desc">Mới nhất</option>
                            <option value="date-asc">Cũ nhất</option>
                            <option value="amount-desc">Giá cao nhất</option>
                            <option value="amount-asc">Giá thấp nhất</option>
                            <option value="status">Theo trạng thái</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="filter-label" style="opacity: 0;">Action</label>
                        <button class="btn btn-secondary" onclick="clearFilters()">
                            <i class="fas fa-times-circle"></i> Xóa lọc
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Orders List -->
        <div class="orders-container">
            <div class="orders-header">
                <div class="orders-count">
                    Hiển thị: <strong id="filtered-count">0</strong> / <strong id="total-count">0</strong> đơn hàng
                </div>
                <button class="btn btn-primary btn-sm" onclick="refreshOrders()">
                    <i class="fas fa-sync-alt"></i> Làm mới
                </button>
            </div>
            
            <div id="orders-list">
                <!-- Loading state -->
                <div style="text-align: center; padding: 40px; color: #7f8c8d;">
                    <i class="fas fa-spinner fa-spin" style="font-size: 3rem; margin-bottom: 15px;"></i>
                    <p>Đang tải dữ liệu...</p>
                </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Scripts -->
    <script src="data-sync.js"></script>
    <script src="customer-my-orders.js"></script>
</body>
</html>
